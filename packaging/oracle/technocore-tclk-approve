#!/usr/bin/env bash
set -euo pipefail

# Root-operated, fixed-shape first-pilot approval. No task text, room, URL or
# arbitrary message is accepted. The exact approval JSON is produced by the
# Python validator and persisted root-owned before the one-shot signer starts.

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo 'tclk approval requires root' >&2
  exit 1
fi
if [[ $# -ne 3 ]]; then
  echo 'usage: technocore-tclk-approve <stage-id> <approval-digest> APPROVE' >&2
  exit 2
fi

STAGE=$1
DIGEST=$2
CONFIRM=$3
[[ $STAGE =~ ^[0-9a-f]{32}$ ]] || { echo 'invalid stage id' >&2; exit 2; }
[[ $DIGEST =~ ^[0-9a-f]{64}$ ]] || { echo 'invalid approval digest' >&2; exit 2; }
[[ $CONFIRM == APPROVE ]] || { echo 'exact APPROVE confirmation required' >&2; exit 2; }

REPO=/opt/technocore-safe-agent
STATE=/var/lib/technocore-safe-agent
DIR=$STATE/signer/tclk-pilot-approvals
DEST=$DIR/$STAGE.json
UNIT=technocore-safe-agent-tclk-accept@${STAGE}.service

install -d -o root -g technocore-signer -m 0750 "$DIR"
if [[ -e $DEST || -L $DEST ]]; then
  echo 'approval already exists; refusing replacement' >&2
  exit 1
fi

TMP=$(mktemp "$DIR/.approval.XXXXXX")
cleanup(){ rm -f "$TMP"; }
trap cleanup EXIT

PYTHONPATH=$REPO/src FLOP_STATE_DIR=$STATE \
  "$REPO/.venv/bin/python" -m flop_agent.tclk_pilot_approval \
  "$STAGE" "$DIGEST" APPROVE > "$TMP"

[[ -s $TMP ]] || { echo 'approval validator returned no record' >&2; exit 1; }
chown root:technocore-signer "$TMP"
chmod 0640 "$TMP"
mv "$TMP" "$DEST"
trap - EXIT

systemctl start "$UNIT"
echo "TCLK_FIRST_PILOT_ACCEPT=started stage=$STAGE"
