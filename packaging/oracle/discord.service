[Unit]
Description=technocore-safe-agent Discord control
After=network-online.target

[Service]
Type=simple
User=technocore
WorkingDirectory=/opt/technocore-safe-agent
EnvironmentFile=/etc/technocore-safe-agent/env
Environment=FLOP_STATE_DIR=/var/lib/technocore-safe-agent
Environment=PYTHONPATH=/opt/technocore-safe-agent/src
ExecStart=/usr/local/bin/uv run --project /opt/technocore-safe-agent python -m flop_agent.discord_control
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/technocore-safe-agent

[Install]
WantedBy=multi-user.target
