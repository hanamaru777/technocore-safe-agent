[Unit]
Description=Technocore Close Call non-binding autonomous rehearsal resident
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=technocore
Group=technocore-autopilot
WorkingDirectory=/opt/technocore-safe-agent
Environment=FLOP_STATE_DIR=/var/lib/technocore-safe-agent
Environment=PYTHONPATH=/opt/technocore-safe-agent/src
ExecStart=/opt/technocore-safe-agent/.venv/bin/python -m flop_agent.close1_autonomous_resident
Restart=on-failure
RestartSec=30s
TimeoutStopSec=10s
MemoryMax=128M
TasksMax=32
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/technocore-safe-agent/close1

[Install]
WantedBy=multi-user.target
