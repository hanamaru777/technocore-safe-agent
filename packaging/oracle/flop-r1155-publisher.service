[Unit]
Description=One NEW independently approved fixed-template publication
Requires=flop-r1155-signer.service flop-r1155-old-post-deny.service
After=flop-r1155-signer.service flop-r1155-old-post-deny.service
[Service]
Type=oneshot
User=flop-r1155-publisher
Group=flop-r1155-publisher
ExecStart=/opt/flop-r1155-runtime/.venv/bin/python -I -B /usr/local/libexec/flop-r1155/packaging/migration/r1155_publisher.py
StateDirectory=flop-r1155-publisher
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=169.254.169.254
InaccessiblePaths=-/etc/technocore-safe-agent -/var/lib/technocore-safe-agent -/var/lib/flop-r1155-signer -/opt/tradebot -/var/lib/tradebot
ReadWritePaths=/var/lib/flop-r1155-publisher
MemoryMax=128M
CPUQuota=25%
TasksMax=16
