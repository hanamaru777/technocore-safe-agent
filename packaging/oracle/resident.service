[Unit]
Description=technocore-safe-agent resident observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=technocore
WorkingDirectory=/opt/technocore-safe-agent
Environment=FLOP_STATE_DIR=/var/lib/technocore-safe-agent
Environment=PYTHONPATH=/opt/technocore-safe-agent/src
ExecStart=/opt/technocore-safe-agent/.venv/bin/python -m flop_agent.resident_daemon
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/technocore-safe-agent

[Install]
WantedBy=multi-user.target
