[Unit]
Description=Technocore pre-contest readiness supervisor
After=network-online.target technocore-safe-agent-metadata-block.service
Wants=network-online.target
Requires=technocore-safe-agent-metadata-block.service

[Service]
Type=oneshot
User=technocore
Group=technocore-autopilot
WorkingDirectory=/opt/technocore-safe-agent
Environment=FLOP_STATE_DIR=/var/lib/technocore-safe-agent
Environment=PYTHONPATH=/opt/technocore-safe-agent/src
ExecStart=/opt/technocore-safe-agent/.venv/bin/python -m flop_agent.precontest_supervisor
TimeoutStartSec=90
MemoryMax=128M
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=169.254.169.254
ReadWritePaths=/var/lib/technocore-safe-agent/airdrop-radar
