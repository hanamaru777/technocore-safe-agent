# REVIEW ONLY. R1118 deliberately NON-STARTABLE on K137, even if copied
# to systemd by mistake. No verified K137 release contains this new source.
# A future reviewed source/identity/capacity deployment MUST replace this file.
# NO signer unlock, import, POST, or network capability exists.
[Unit]
Description=FLOP R1117 INERT review-only template (NOT DEPLOYABLE)
RefuseManualStart=yes

[Service]
Type=oneshot
User=flop-signer
Group=flop-signer
# Two unconditional independent barriers prevent an accidental service action.
# Never substitute a guessed /opt/technocore-safe-agent or stale stage path.
ExecCondition=/usr/bin/false
ExecStart=/usr/bin/false
StandardInput=null
StandardOutput=journal
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=256M
TasksMax=16
CPUQuota=50%
# Exact historically owner-observed K137 TradeBot directories, plus old
# defensive aliases. Must be freshly rechecked before any future deployment.
InaccessiblePaths=-/opt/tradebot-k137 -/var/lib/tradebot-k137-public -/home/ubuntu/k137-canonical-source -/home/ubuntu/k137q-public-only -/home/ubuntu/k137-public-state -/opt/tradebot -/var/lib/tradebot -/etc/technocore-safe-agent
ReadOnlyPaths=/etc/flop-r1117/public-admission.json
